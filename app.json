{
  "expo": {
    "name": "NutriWorkoutExpert",
    "slug": "NutriWorkoutExpert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutriworkoutexpert",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prangc.nutriworkoutexpert",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "NutriWorkoutExpert uses the camera so you can snap a meal or progress photo. Photos stay on your device unless you opt in to AI analysis.",
        "NSPhotoLibraryUsageDescription": "NutriWorkoutExpert lets you attach a meal or progress photo from your library. Photos stay on your device unless you opt in to AI analysis."
      }
    },
    "android": {
      "package": "com.prangc.nutriworkoutexpert",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriWorkoutExpert lets you attach a meal or progress photo from your library. Photos stay on your device unless you opt in to AI analysis.",
          "cameraPermission": "NutriWorkoutExpert uses the camera so you can snap a meal or progress photo. Photos stay on your device unless you opt in to AI analysis.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#16a34a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "57b6d77e-7587-438e-a206-be41bec6f457"
      }
    },
    "owner": "pran-gc"
  }
}
