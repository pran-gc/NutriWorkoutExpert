# Copy this file to .env and fill in the values. NEVER put real secret keys in
# this file — it is committed to git. Only placeholders here.
#
# ── App (client) env — EXPO_PUBLIC_* only ───────────────────────────────────
# These are baked into the app bundle and are PUBLIC by design (the anon /
# publishable key is safe to ship). Local dev points at the Docker stack; the
# hosted values live in .env.production (gitignored).
#   Local:  EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   Hosted: EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_local_key_here
#
# ── Server secrets — DO NOT put these in any .env the app reads ──────────────
# GEMINI_API_KEY, USDA_FDC_API_KEY, CRON_SECRET, ENVIRONMENT live ONLY in
# Supabase Edge Function secrets, set with:
#   supabase secrets set GEMINI_API_KEY=... USDA_FDC_API_KEY=... \
#     CRON_SECRET=$(openssl rand -hex 32) ENVIRONMENT=production
# They are NEVER bundled into the client. See docs/release-runbook.md.
