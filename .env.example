# Copy this file to .env and fill in the values.
#
# ── Local development (supabase start) ──────────────────────────────────────
# `supabase start` prints these. The publishable key is the app's anon key.
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...   (from `supabase start` output)
#
# ── Hosted (real app) ───────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API.
#   EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
#
# Only EXPO_PUBLIC_* vars may reach the client. Service/secret keys and the
# Gemini key live ONLY in Edge Function secrets (`supabase secrets set`), never here.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
